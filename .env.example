# Copie este arquivo para .env e ajuste se necessário.
# Os valores abaixo já são os defaults usados pelo docker-compose.yml —
# não é necessário criar um .env para rodar via Docker.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=cinebridge
DB_PASSWORD=cinebridge
DB_NAME=cinebridge_recomendacao

# true (default) cria/atualiza o schema automaticamente ao conectar.
# Defina como "false" se preferir gerenciar o schema via migrations.
DB_SYNCHRONIZE=true

# "true" para logar todas as queries SQL executadas pelo TypeORM.
DB_LOGGING=false

# --- Integrações com sistemas externos (Adapter) ---------------------------
# Armazenamento de arquivos de mídia: local | s3 | google-cloud
ADAPTADOR_ARMAZENAMENTO=local
# Pagamentos entre produtores e profissionais: stripe | pagseguro | paypal
ADAPTADOR_PAGAMENTO=stripe
# Origem dos profissionais candidatos: interno | linkedin | indeed
ADAPTADOR_PROFISSIONAL=interno

# --- Decoradores do recomendador (Decorator) -------------------------------
# Pilha aplicada quando a requisição não escolhe uma, do mais interno ao mais
# externo: cache | auditoria | compressao (separados por vírgula). "none" desliga.
RECOMENDACAO_DECORADORES=cache,auditoria
